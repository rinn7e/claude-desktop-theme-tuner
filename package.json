{
  "name": "claude-desktop-theme-tuner",
  "private": true,
  "version": "0.1.0",
  "description": "Theme the Claude desktop app: a web app to design themes, and a Claude Code mod that applies them",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web-app dev",
    "build": "pnpm --filter web-app build",
    "check": "pnpm --filter web-app check",
    "lint": "pnpm --filter web-app lint",
    "test": "pnpm --filter web-app test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier": "^3.8.1"
  }
}
